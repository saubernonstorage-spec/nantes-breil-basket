# Envoi des formulaires (contact + inscription aux stages) par e-mail.
# Copiez ce fichier en « .env.local » pour tester en local, ou saisissez ces variables
# dans Vercel (Settings → Environment Variables). Ne publiez jamais le vrai mot de passe.
#
# Exemples de serveurs SMTP :
#   Gmail / Google Workspace : smtp.gmail.com, port 465 (mot de passe d'application obligatoire)
#   OVH (MX Plan)            : ssl0.ovh.net, port 465

SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Adresse(s) qui reçoivent les messages du formulaire de contact (séparées par des virgules)
FORM_TO=

# Facultatif : adresse(s) qui reçoivent les inscriptions aux stages (sinon FORM_TO)
FORM_TO_STAGES=

# Facultatif : adresse d'expédition (sinon SMTP_USER)
FORM_FROM=
