# Variables d'environnement du site (à saisir dans le hPanel Hostinger : application Node.js → variables d'environnement,
# ou à copier dans un fichier « .env.local » pour tester en local). Ne publiez jamais les vraies valeurs.

# ─── Espace dirigeants (/espace-dirigeants) ───
# Mot de passe partagé par le bureau pour consulter les demandes reçues (inscriptions, stages, messages).
# Choisissez une phrase longue ; le changer déconnecte tout le monde.
ADMIN_PASSWORD=
# Facultatif : chaîne aléatoire supplémentaire pour signer la session.
ADMIN_SECRET=

# ─── Envoi des e-mails (facultatif, mais nécessaire aux confirmations de stage) ───
# Sert à transmettre les demandes au club et à envoyer aux parents la confirmation d'inscription au stage
# (bouton « Confirmer par e-mail » de l'Espace dirigeants). Sans ces variables, les demandes sont
# seulement enregistrées dans l'Espace dirigeants et le bouton de confirmation reste grisé.
# Exemples de serveurs SMTP :
#   Brevo                    : smtp-relay.brevo.com, port 587 ; SMTP_USER = identifiant SMTP et SMTP_PASS = clé SMTP
#                              (Brevo → SMTP et API → onglet SMTP ; pas la clé API) ; FORM_FROM obligatoire (voir README.md)
#   Gmail / Google Workspace : smtp.gmail.com, port 465 (mot de passe d'application obligatoire)
#   OVH (MX Plan)            : ssl0.ovh.net, port 465
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Adresse(s) qui reçoivent les messages du formulaire de contact (séparées par des virgules)
FORM_TO=

# Facultatif : destinataires des préinscriptions et des inscriptions aux stages (sinon FORM_TO)
FORM_TO_INSCRIPTIONS=
FORM_TO_STAGES=

# ─── Stockage des données ───
# Dossier où sont enregistrés demandes, convocations et base des adhérents (fichiers JSON). Sur un serveur,
# un chemin absolu hors du dossier du site, pour qu'il ne soit pas effacé à chaque déploiement
# (ex. /home/u597131010/donnees-nbb). Par défaut .donnees/ à la racine du projet (développement local).
DOSSIER_DONNEES=

# Facultatif : adresse d'expédition (sinon SMTP_USER). Obligatoire avec Brevo : un expéditeur validé dans Brevo,
# sur le domaine du club (ex. contact@nbb44.fr)
FORM_FROM=
